# LabSense AI Backend Configuration
# Environment: development / production
ENVIRONMENT=development
DEBUG=true

# Server Binding (Localhost only for privacy & development)
HOST=127.0.0.1
PORT=8000

# SQLite Database URL (stored in backend/data/labsense.db)
DATABASE_URL=sqlite:///./data/labsense.db

# Allowed CORS Origins (Frontend local development)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Application Metadata
APP_NAME=LabSense AI Backend
APP_VERSION=0.1.0
