# LabSense AI - Frontend Environment Configuration
#
# Local Development:
# Leave VITE_API_BASE_URL empty to use the local Vite development proxy (/api -> http://127.0.0.1:8000).
#
# Production / Staging on Render:
# Set this to your deployed Render backend web service URL:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
